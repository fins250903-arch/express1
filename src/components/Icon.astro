---
/**
 * Inline SVG stand-in for the Font Awesome classes previously loaded
 * from the full 6.4.0 CDN stylesheet.
 *
 * Paths are the Font Awesome Free 6.4.0 glyphs (see faIcons.ts for the
 * CC BY 4.0 / SIL OFL / MIT attribution).
 */
import { FA_ICONS } from './faIcons';

interface Props {
  /** Icon name without the style prefix, e.g. "phone-alt" or "fa-line". */
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const key = name.replace(/^fa-/, '');
const icon = FA_ICONS[key];

if (!icon) {
  throw new Error(`Unknown icon "${name}". Add it to src/components/faIcons.ts.`);
}

const [, , rawW, rawH] = icon.viewBox.split(/[\s,]+/);
const widthEm = (Number(rawW) / Number(rawH)).toFixed(4);
---

<i class:list={['fa-icon', className]} aria-hidden="true">
  <svg
    viewBox={icon.viewBox}
    focusable="false"
    aria-hidden="true"
    style={`width:${widthEm}em;height:1em`}
  >
    <path fill="currentColor" d={icon.d} />
  </svg>
</i>
