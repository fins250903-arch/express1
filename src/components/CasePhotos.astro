---
import { Image } from 'astro:assets';
import atraiDoor from '../../public/images/blog/atraiosaka/cover.png';
import hiaceHatch from '../content/blog/kythiace/images/ハイエース、後ろリアハッチ、レトニング前のA。-e1777476623642.jpg';
import hiaceCeiling from '../content/blog/hiaceten/images/hiace.jpg';
import levorgTire from '../content/blog/revogoto/images/スバル・レヴォーグタイヤデッド-e1776346061143.jpg';
import auraDoor from '../content/blog/noteaura2604/images/202603301-576x1024.jpg';
import floorBluePedals from '../assets/cases/floor-blue-pedals.jpg';
import floorBlue from '../assets/cases/floor-blue.jpg';
import roofBlue from '../assets/cases/roof-blue.jpg';
import slideDoorBlue from '../assets/cases/slide-door-blue.jpg';
import sideDoorSilverEgg from '../assets/cases/side-door-silver-egg.jpg';
import rearHatchTrimOff from '../assets/cases/rear-hatch-trim-off.jpg';
import sideFloorQuilt from '../assets/cases/side-floor-quilt.jpg';
import sidePanelQuilt from '../assets/cases/side-panel-quilt.jpg';

// Captions are limited to the car and the treatment named in each post.
// hiacekazoku reuses the same ceiling photo as hiaceten, so it is not shown twice.
// The generic red-sheet photo in the Aura post is the unlabeled gallery image, so it is omitted.
const cases = [
  {
    image: atraiDoor,
    alt: 'スズキ・アトレーのドア内側。制振シートが貼ってある',
    car: 'スズキ・アトレー',
    work: 'ドア内側の制振シート',
    href: '/blog/atraiosaka/',
  },
  {
    image: hiaceHatch,
    alt: 'ハイエースのリアハッチ。内張りを外して内側の鉄板が見えている',
    car: 'ハイエース',
    work: '京都市・リアハッチ内側（内張りを外した段階）',
    href: '/blog/kythiace/',
  },
  {
    image: hiaceCeiling,
    alt: 'ハイエースの天井内側。内張りを外して資材を貼ってある',
    car: 'ハイエース',
    work: '天井のデッドニング（雨音・遮熱）',
    href: '/blog/hiaceten/',
  },
  {
    image: levorgTire,
    alt: 'スバル・レヴォーグのタイヤハウス内側。制振シートが貼ってある',
    car: 'スバル・レヴォーグ',
    work: 'タイヤハウスの制振（ロードノイズ）',
    href: '/blog/revogoto/',
  },
  {
    image: auraDoor,
    alt: '日産ノート オーラのドアを開けたところ',
    car: '日産ノート オーラ（FE13）',
    work: 'ドアのデッドニング',
    href: '/blog/noteaura2604/',
  },
].map(withSrcWidths);

// Shop photos of a Toyota Hiace and a Nissan Caravan. The owner did not say
// which frame is which vehicle, so every caption stays on the shared label
// plus only the material and place that are visible in that frame.
const shopShots = [
  {
    image: floorBluePedals,
    alt: 'ハイエース・キャラバンの施工例。ペダル付近のフロアに青い制振シートが貼ってある',
    label: 'ハイエース・キャラバンの施工例',
    work: 'フロア（ペダル付近）に青い制振シート',
  },
  {
    image: floorBlue,
    alt: 'ハイエース・キャラバンの施工例。フロアに青い制振シートが貼ってあり、中央に部品が見える',
    label: 'ハイエース・キャラバンの施工例',
    work: 'フロアに青い制振シート',
  },
  {
    image: roofBlue,
    alt: 'ハイエース・キャラバンの施工例。天井に青い制振シートが貼ってあり、左右の端はシルバーの制振シート',
    label: 'ハイエース・キャラバンの施工例',
    work: '天井に青い制振シート（左右の端はシルバー）',
  },
  {
    image: slideDoorBlue,
    alt: 'ハイエース・キャラバンの施工例。スライドドアの内側に青い制振シートが貼ってある',
    label: 'ハイエース・キャラバンの施工例',
    work: 'スライドドアに青い制振シート',
  },
  {
    image: sideDoorSilverEgg,
    alt: 'ハイエース・キャラバンの施工例。側面のドアパネルにシルバーの制振シートと、黒い卵型の吸音材が貼ってある',
    label: 'ハイエース・キャラバンの施工例',
    work: '側面のドアパネルにシルバーの制振シートと卵型の吸音材',
  },
  {
    image: rearHatchTrimOff,
    alt: 'ハイエース・キャラバンの施工例。リアゲートの内張りを外し、内側の鉄板と配線が見えている',
    label: 'ハイエース・キャラバンの施工例',
    work: 'リアゲート（内張りを外した状態）',
  },
  {
    image: sideFloorQuilt,
    alt: 'ハイエース・キャラバンの施工例。側面とフロアに黒いキルティングの吸音材があり、端に青い制振シートと卵型の吸音材が見える',
    label: 'ハイエース・キャラバンの施工例',
    work: '側面とフロアに黒いキルティングの吸音材。端に青い制振シートと卵型の吸音材',
  },
  {
    image: sidePanelQuilt,
    alt: 'ハイエース・キャラバンの施工例。側面パネルに黒いキルティングの吸音材が貼ってある',
    label: 'ハイエース・キャラバンの施工例',
    work: '側面パネルに黒いキルティングの吸音材',
  },
].map(withSrcWidths);

function withSrcWidths<T extends { image: { width: number } }>(item: T) {
  return {
    ...item,
    widths: [...[320, 480, 640, 800].filter((width) => width < item.image.width), item.image.width],
  };
}
---

<section class="case-photos" id="case-photos" aria-labelledby="case-photos-title">
  <div class="container">
    <h2 id="case-photos-title" class="section-title">施工写真・施工事例</h2>
    <p class="case-lead">
      施工ブログに載せている写真です。車種と箇所は、記事に書いてあることだけを抜いています。
    </p>
    <ul class="case-grid">
      {
        cases.map((item) => (
          <li>
            <a class="case-card" href={item.href}>
              <span class="case-photo">
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={item.widths}
                  sizes="(min-width: 640px) 340px, calc(100vw - 32px)"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="case-body">
                <span class="case-car">{item.car}</span>
                <span class="case-work">{item.work}</span>
                <span class="case-read">記事を読む</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="case-index">
      <a href="/blog/">施工ブログの一覧を見る</a>
    </p>

    <h3 id="hiace-caravan-gallery-title" class="case-subhead">ハイエース・キャラバン施工ギャラリー</h3>
    <p class="case-note">
      トヨタ ハイエースと日産 キャラバンの施工写真です。写真だけでは車種を分けられないため、どちらも同じ見出しにし、写っている箇所と資材だけを書いています。
    </p>
    <ul class="case-grid shot-grid">
      {
        shopShots.map((item) => (
          <li>
            <figure class="shot-card">
              <span class="case-photo">
                <Image
                  src={item.image}
                  alt={item.alt}
                  format="webp"
                  widths={item.widths}
                  sizes="(min-width: 640px) 340px, calc(100vw - 32px)"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <figcaption class="case-body">
                <span class="case-car">{item.label}</span>
                <span class="case-work">{item.work}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .case-photos {
    padding: 40px 0;
    background: #f7f8fb;
  }
  .case-lead {
    text-align: center;
    font-size: 13px;
    color: #666;
    line-height: 1.7;
    margin: -18px 0 18px;
  }
  .case-grid {
    list-style: none;
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .case-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid #e8ecf0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .case-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }
  .case-card:focus-visible {
    outline: 3px solid var(--color-gold);
    outline-offset: 2px;
  }
  .case-photo {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    background: #e8edf3;
    overflow: hidden;
  }
  .case-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .case-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 14px 16px;
    flex-grow: 1;
  }
  .case-car {
    font-size: 15px;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.4;
  }
  .case-work {
    font-size: 13px;
    color: #555;
    line-height: 1.6;
  }
  .case-read {
    margin-top: 8px;
    font-size: 12px;
    font-weight: 800;
    color: var(--color-accent);
  }
  .case-index {
    text-align: center;
    margin-top: 18px;
  }
  .case-index a {
    display: inline-block;
    font-size: 14px;
    font-weight: 800;
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-gold);
    padding: 4px 2px 2px;
    min-height: 44px;
  }
  .case-index a:focus-visible {
    outline: 3px solid var(--color-gold);
    outline-offset: 2px;
  }
  .case-subhead {
    font-size: clamp(18px, 4.4vw, 22px);
    font-weight: 900;
    text-align: center;
    color: var(--color-primary);
    line-height: 1.4;
    margin: 36px 0 12px;
  }
  .case-note {
    text-align: center;
    font-size: 13px;
    color: #666;
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .shot-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    background: #fff;
    border: 1px solid #e8ecf0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }
  .shot-card .case-photo {
    aspect-ratio: 3 / 4;
  }
  @media (min-width: 640px) {
    .case-grid {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case-card {
      transition: none;
    }
  }
</style>
