---
interface Props {
  problemCity: string;
  problemList?: string[];
  solutionTitle?: string;
  solutionText?: string;
}

const { 
  problemCity,
  problemList = [
    "専門店で見積もったら<strong>10万円を超えた…</strong>",
    "自分でやろうとドアを外しかけたが、<strong>元に戻せるか不安…</strong>",
    "格安店は<strong>「持ち込み不可」ばかりでガッカリ…</strong>",
    "平日は忙しく<strong>車を預けに行く時間がない…</strong>",
    "デッドニングって<strong>本当に効果があるの？</strong>"
  ],
  solutionTitle = "その悩み、特急便がすべて解決します！",
  solutionText = `デッドニングは、スピーカー交換と<strong>同時にやるのが「一番安くて一番効く」</strong>んです。<br>セットで依頼すればコスト大幅カット。施工後は「え、こんなに変わるの？」と<br>驚かれるお客様が<strong>${problemCity}で続出中！</strong>`
} = Astro.props;
---
<section class="empathy-section" id="empathy">
  <div class="container">
    <h2 class="section-title">「車内をもっと快適にしたい。でも…」<br><span class="text-red">こんなお悩み、ありませんか？</span></h2>
    <ul class="problem-list fade-in">
      {problemList.map(item => (
        <li>
          <i class="fas fa-sad-cry text-accent text-lg mt-1 flex-shrink-0"></i>
          <span set:html={item} />
        </li>
      ))}
    </ul>
    <div class="insight-box fade-in">
      <div class="insight-icon"><i class="fas fa-lightbulb"></i></div>
      <p class="insight-title">{solutionTitle}</p>
      <p class="insight-text" set:html={solutionText} />
    </div>
  </div>
</section>

