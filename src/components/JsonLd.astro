---
interface Props {
  prefName: string;
  keywordName: string;
  description: string;
  canonical: string;
  faqItems: { q: string; a: string }[];
  offers: {
    '@type': 'Offer';
    itemOffered: { '@type': 'Service'; name: string; description?: string };
    price: string;
    priceCurrency: 'JPY';
  }[];
  priceRange: string;
}

import { buildDateISO } from '../utils/buildDate';
import { organizationSchema, SHARE_IMAGE_URL } from '../data/trustSignals';

const { prefName, keywordName, description, canonical, faqItems, offers, priceRange } = Astro.props;

// Re-compile strict breadcrumb items based on URL path.
// `/` is a permanent redirect, so the visible home is the deadning hub.
const pathParts = canonical.replace("https://abura.site/", "").split("/").filter(Boolean);

const breadcrumbList = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ホーム",
      "item": "https://abura.site/deadning/"
    },
    ...pathParts.map((part, index) => {
      const currentUrl = `https://abura.site/${pathParts.slice(0, index + 1).join("/")}/`;
      let name = part;
      if (index === 0) name = `${prefName}施工エリア`;
      if (index === 1) name = keywordName;
      return {
        "@type": "ListItem",
        "position": index + 2,
        "name": name,
        "item": currentUrl
      };
    })
  ]
};

const jsonGraph = [
  organizationSchema(),
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    "url": canonical,
    "name": `${prefName}の出張${keywordName}`,
    "description": description,
    "inLanguage": "ja-JP",
    "datePublished": "2025-01-01",
    "dateModified": buildDateISO
  },
  {
    "@type": "Service",
    "@id": `${canonical}#service`,
    "name": `${prefName}の出張${keywordName}施工サービス`,
    "description": description,
    "provider": { "@id": "https://abura.site/#organization" },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": prefName
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": `${keywordName}の料金メニュー`,
      "itemListElement": offers
    }
  },
  {
    "@type": "LocalBusiness",
    "@id": `${canonical}#business`,
    "name": `車の出張パーツ取付 特急便 ${prefName}エリア窓口`,
    "image": SHARE_IMAGE_URL,
    "url": canonical,
    "telephone": "070-8428-0866",
    "priceRange": priceRange,
    "address": {
      "@type": "PostalAddress",
      "addressRegion": prefName,
      "addressCountry": "JP"
    },
    "areaServed": {
      "@type": "State",
      "name": prefName
    },
    "parentOrganization": { "@id": "https://abura.site/#organization" }
  },
  {
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  },
  breadcrumbList
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": jsonGraph
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
