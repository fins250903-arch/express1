---
import { getCollection } from 'astro:content';

interface Props {
  currentRegion?: string;
}

const { currentRegion } = Astro.props;

// Dynamically fetch all existing regions LPs
const allRegions = await getCollection('regions');

// Define region grouping and display order
const areas = [
  {
    name: '関西エリア',
    slugs: ['osaka', 'hyogo', 'kyoto', 'shiga', 'nara', 'wakayama']
  },
  {
    name: '東海エリア',
    slugs: ['aichi', 'mie']
  },
  {
    name: '四国エリア',
    slugs: ['kagawa', 'tokushima']
  }
];

// Map regions for fast name lookups
const regionMap = new Map(allRegions.map(r => [r.id, r.data.prefName]));
---
<footer id="footer">
  <div class="footer-info">
    <p class="footer-name">車の出張パーツ取付 特急便</p>
    <p>対応エリア：関西・東海・四国</p>
    <p>TEL：<a href="tel:070-8428-0866">070-8428-0866</a></p>
    <p>営業時間：9:00〜19:00（不定休）</p>
  </div>

  <!-- Unified Navigation grouped by Area -->
  <nav class="footer-nav-area">
    <div class="area-group-container">
      {areas.map((area) => {
        // Filter and map only active/existing regions in this area
        const activeRegionsInArea = area.slugs
          .filter(slug => regionMap.has(slug))
          .map(slug => ({
            slug,
            name: regionMap.get(slug) || ''
          }));

        if (activeRegionsInArea.length === 0) return null;

        return (
          <div class="area-group">
            <span class="area-label">{area.name}</span>
            <div class="area-links">
              {activeRegionsInArea.map((region) => (
                <a 
                  href={`/deadning/${region.slug}/`} 
                  class={currentRegion === region.slug ? 'active' : ''}
                >
                  {region.name}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </nav>

  <p class="footer-copy">&copy; 2026 車の出張パーツ取付 特急便. All Rights Reserved.</p>
</footer>

<style>
  .footer-nav-area {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 25px;
    padding-top: 25px;
  }
  .area-group-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
  }
  @media (min-width: 768px) {
    .area-group-container {
      flex-direction: row;
      justify-content: space-between;
      gap: 30px;
    }
  }
  .area-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: rgba(255, 255, 255, 0.03);
    padding: 16px 20px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  .area-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-gold);
    border-left: 3px solid var(--color-gold);
    padding-left: 8px;
    line-height: 1;
  }
  .area-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .area-links a {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
    padding: 4px 12px;
    border-radius: 20px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .area-links a:hover {
    color: var(--color-white);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .area-links a.active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
