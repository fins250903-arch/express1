---
interface Props {
  relatedRegions?: { name: string; slug: string; active?: boolean }[];
  currentRegion?: string;
}

const { relatedRegions = [], currentRegion = "" } = Astro.props;

const regionLinks = relatedRegions.filter((region) => region.slug !== currentRegion);
---
{regionLinks.length > 0 && (
  <section class="related-section" id="related">
    <div class="container">
      <h2>🔗 出張デッドニング 関連エリア</h2>
      <div class="related-grid fade-in">
        {regionLinks.map((region) => (
          <a href={`/deadning/${region.slug}/`} class="related-card">
            <div class="related-card-icon"><i class="fas fa-volume-up"></i></div>
            <div class="related-card-text">
              <h3>{region.name} デッドニング施工</h3>
              <p>{region.name}全域に対応。左右ドア静音化 2.8万円〜</p>
            </div>
            <i class="fas fa-chevron-right related-card-arrow"></i>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
