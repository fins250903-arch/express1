---
interface Props {
  pricingNote: string;
  priceTable?: { menu: string; desc: string; price: string }[];
}

const { 
  pricingNote,
  priceTable = [
    { menu: "🏆 フロントドア デッドニング＋スピーカー交換セット", desc: "フロント左右2枚・材料持込OK", price: "29,000円〜" },
    { menu: "スピーカー交換のみ", desc: "フロント左右", price: "12,000円〜" },
    { menu: "デッドニングのみ", desc: "フロントドア左右", price: "15,000円〜" },
    { menu: "リアドア デッドニング＋スピーカー交換セット", desc: "リア左右2枚・材料持込OK", price: "20,000円〜" }
  ]
} = Astro.props;
---
<section class="pricing-section" id="pricing">
  <div class="container">
    <h2 class="section-title">主要メニューと料金（税込）</h2>
    <div class="fade-in">
      <table class="price-table">
        <thead>
          <tr>
            <th>メニュー</th>
            <th style="text-align:right">工賃（税込）</th>
          </tr>
        </thead>
        <tbody>
          {priceTable.map(row => (
            <tr>
              <td>
                <strong set:html={row.menu} />
                <br />
                <small class="text-white/60" set:html={row.desc} />
              </td>
              <td class="price-highlight" style="text-align:right" set:html={row.price} />
            </tr>
          ))}
        </tbody>
      </table>
      <div class="price-note-box" set:html={pricingNote.replace(/\n/g, '<br>')} />
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .mobile-only { display: none; }
  }
</style>

