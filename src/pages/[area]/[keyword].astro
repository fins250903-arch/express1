const currentCampaign = campaignData[keyword as keyof typeof campaignData];

// Format canonical URL for the 24 LPs (Self-referential Canonical URL)
const resolvedCanonical = `https://abura.site/${area}/${keyword}/`;

// Merge regional FAQs with Campaign Specific FAQs to build a powerful 5-item FAQ matrix
const mergedFaqItems = [
  ...currentCampaign.specificFaqs,
  ...data.faqItems.slice(0, 3)
];

// Compile localized conclusions first for AIO Search (conclusion-first, ~50 characters)
const localizedAioDefinition = `${data.prefName}の出張${currentCampaign.name}施工は、ご自宅の駐車場でお車をお預かりせず、プロが店舗型の半額以下で施工する防音断熱サービスです。`;

// Compile dynamic description
const dynamicDescription = `${data.prefName}にてプロがご自宅の駐車場で仕上げる出張${currentCampaign.seoKeyword}。材料持ち込み完全無料！当日追加料金一切なし。店舗型専門店の半額以下の工賃${currentCampaign.priceTable[0].price}〜で、驚きの静粛性と快適空間をご提供します！`;
---

<Layout 
  title={`${data.prefName}の出張${currentCampaign.seoKeyword}【特急便】材料持込無料・当日追加料金なし`} 
  description={dynamicDescription} 
  canonical={resolvedCanonical} 
  region={area}
  keyword={keyword}
>
  <!-- Interactive Dynamic JSON-LD -->
  <JsonLd 
    prefName={data.prefName}
    keywordName={currentCampaign.name}
    description={dynamicDescription}
    canonical={resolvedCanonical}
    faqItems={mergedFaqItems}
  />

  <FV 
    prefName={data.prefName} 
    aioDefinition={localizedAioDefinition}
    fvCatch={currentCampaign.fvCatch}
    fvSub={currentCampaign.fvSub}
    badgeList={currentCampaign.badgeList}
    pointsList={currentCampaign.pointsList}
    bgImage={currentCampaign.bgImage}
  />

  <main>
    <UpdateDate />
    <Empathy 
      problemCity={data.problemCity} 
      problemList={currentCampaign.problemList}
      solutionTitle={currentCampaign.solutionTitle}
      solutionText={currentCampaign.solutionText}
    />
    
    <Solution />
    
    <Reasons reasonsCity={data.reasonsCity} />
    
    <Flow flowCity={data.flowCity} />
    
    <!-- Image Fallback handling included -->
    <Gallery />
    
    <Voice voiceCity={data.voiceCity} voiceItems={data.voiceItems} />
    
    <MidCTA />
    
    <Pricing 
      pricingNote={data.pricingNote} 
      priceTable={currentCampaign.priceTable}
    />
    
    <Comparison prefName={data.prefName} />
    
    <ServicePlan prefName={data.prefName} />
    
    <FAQ prefName={data.prefName} faqItems={mergedFaqItems} />
    
    <Related relatedRegions={data.relatedRegions} currentRegion={area} />
    
    <Area prefName={data.prefName} areaBlocks={data.areaBlocks} />
    
    <!-- Strong Final conversion CTA box -->
    <div class="max-w-[760px] mx-auto px-4 py-8">
      <CTA 
        title={`${data.prefName}で最高の愛車空間を手に入れませんか？`}
        subtitle={`ご自宅のガレージや駐車場で完結するため、店舗に車を預けに行く手間は一切ありません。車種や施工範囲に合わせてプロが丁寧に施工いたします。LINE相談・お見積もりは完全無料です。`}
      />
    </div>

    <Closing prefName={data.prefName} />
  </main>

  <Footer currentArea={area} currentKeyword={keyword} />
</Layout>
