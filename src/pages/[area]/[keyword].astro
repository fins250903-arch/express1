---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FV from '../../components/FV.astro';
import Empathy from '../../components/Empathy.astro';
import Solution from '../../components/Solution.astro';
import Reasons from '../../components/Reasons.astro';
import Flow from '../../components/Flow.astro';
import Gallery from '../../components/Gallery.astro';
import Voice from '../../components/Voice.astro';
import MidCTA from '../../components/MidCTA.astro';
import Pricing from '../../components/Pricing.astro';
import Comparison from '../../components/Comparison.astro';
import ServicePlan from '../../components/ServicePlan.astro';
import FAQ from '../../components/FAQ.astro';
import Related from '../../components/Related.astro';
import Area from '../../components/Area.astro';
import Closing from '../../components/Closing.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import CTA from '../../components/CTA.astro';
import UpdateDate from '../../components/UpdateDate.astro';

export async function getStaticPaths() {
  const regions = await getCollection('regions');
  const targetAreaSlugs = ['osaka', 'hyogo', 'wakayama', 'nara', 'mie', 'kyoto', 'shiga', 'aichi'];
  
  // Filter only targeted areas
  const filteredRegions = regions.filter(r => targetAreaSlugs.includes(r.id));
  
  const keywords = [
    { slug: 'tire-house', name: 'タイヤハウスデッドニング' },
    { slug: 'hiace', name: 'ハイエースデッドニング' },
    { slug: 'insulation', name: '断熱防音' }
  ];
  
  const paths = [];
  for (const region of filteredRegions) {
    for (const kw of keywords) {
      paths.push({
        params: { area: region.id, keyword: kw.slug },
        props: { regionEntry: region, keywordObj: kw }
      });
    }
  }
  return paths;
}

const { regionEntry, keywordObj } = Astro.props;
const { area, keyword } = Astro.params;
const data = regionEntry.data;

