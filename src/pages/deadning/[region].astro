---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FV from '../../components/FV.astro';
import AnswerTarget from '../../components/AnswerTarget.astro';
import Empathy from '../../components/Empathy.astro';
import Solution from '../../components/Solution.astro';
import Reasons from '../../components/Reasons.astro';
import Flow from '../../components/Flow.astro';
import Gallery from '../../components/Gallery.astro';
import Voice from '../../components/Voice.astro';
import MidCTA from '../../components/MidCTA.astro';
import Pricing from '../../components/Pricing.astro';
import Comparison from '../../components/Comparison.astro';
import ServicePlan from '../../components/ServicePlan.astro';
import FAQ from '../../components/FAQ.astro';
import Related from '../../components/Related.astro';
import Area from '../../components/Area.astro';
import Closing from '../../components/Closing.astro';
import Footer from '../../components/Footer.astro';
import UpdateDate from '../../components/UpdateDate.astro';
import { buildDateISO } from '../../utils/buildDate';
import { buildDeadningFaqs, DEADNING_OFFERS } from '../../data/faqs';
import { organizationSchema, TRUST } from '../../data/trustSignals';

export async function getStaticPaths() {
  const excludedRegions = new Set(['tokushima', 'kagawa']);
  const regions = await getCollection('regions');
  return regions
    .filter((entry) => !excludedRegions.has(entry.id))
    .map(entry => ({
      params: { region: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;

const faqItems = buildDeadningFaqs(data.prefName);

const aioDefinitionShort = `${data.prefName}のご自宅駐車場へ、${TRUST.years}・${TRUST.annualJobs}の専門員が直接訪問し、車を預けずに制振・吸音施工で静音化を実現するサービスです。左右ドア${TRUST.doorPrice}、材料・機器持込OK、損害保険対応。`;

const title = data.title.includes('300')
  ? data.title
  : data.title.replace('材料持込OK', '専門員直接訪問・材料持込OK');

const description = `${data.prefName}の出張デッドニング。${TRUST.years}・${TRUST.annualJobs}の専門員が直接訪問。左右ドア${TRUST.doorPrice}、預けず目の前で確認、材料・機器持込同時取付OK、損害保険対応。`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema(),
    {
      "@type": "WebPage",
      "@id": `${data.canonical}#webpage`,
      "url": data.canonical,
      "name": title,
      "description": description,
      "inLanguage": "ja-JP",
      "datePublished": "2025-01-01",
      "dateModified": buildDateISO
    },
    {
      "@type": "Service",
      "@id": `${data.canonical}#service`,
      "name": "車内デッドニング施工サービス",
      "description": aioDefinitionShort,
      "provider": { "@id": "https://abura.site/#organization" },
      "areaServed": { "@type": "State", "name": data.prefName },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "デッドニングメニュー",
        "itemListElement": [...DEADNING_OFFERS]
      }
    },
    {
      "@type": "LocalBusiness",
      "@id": `${data.canonical}#business`,
      "name": `車の出張パーツ取付 特急便 ${data.prefName}拠点`,
      "image": "https://abura.site/images/deadning%20image0.jpg",
      "url": data.canonical,
      "telephone": TRUST.phone,
      "priceRange": "¥28,000〜",
      "address": { "@type": "PostalAddress", "addressRegion": data.prefName, "addressCountry": "JP" },
      "parentOrganization": { "@id": "https://abura.site/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${data.canonical}#faq`,
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://abura.site/" },
        { "@type": "ListItem", "position": 2, "name": "デッドニング出張施工", "item": "https://abura.site/deadning/" },
        { "@type": "ListItem", "position": 3, "name": data.prefName, "item": data.canonical }
      ]
    }
  ]
};

const pricingNote = `✅ 施工歴3年以上・年間300台以上の専門員が直接訪問
✅ 材料持ち込み完全無料／機器同時取付も相談可
✅ 出張費は見積もりに含まれます（${data.prefName}全域）
✅ 損害保険対応・当日追加料金なし`;
---

<Layout 
  title={title} 
  description={description} 
  canonical={data.canonical} 
  region={entry.id}
  jsonLd={jsonLd}
>
  <FV prefName={data.prefName} aioDefinition={aioDefinitionShort} />
  <main>
    <UpdateDate />
    <AnswerTarget prefName={data.prefName} variant="deadning" />
    <Empathy problemCity={data.problemCity} />
    <Solution />
    <Reasons reasonsCity={data.reasonsCity} />
    <Flow flowCity={data.flowCity} />
    <Gallery />
    <Voice voiceCity={data.voiceCity} voiceItems={data.voiceItems} />
    <MidCTA />
    <Pricing pricingNote={pricingNote} priceTable={[
      { menu: "🏆 左右ドア デッドニング（車の静音化）", desc: "制振材・吸音材施工・左右2枚", price: "28,000円〜" },
      { menu: "タイヤハウス デッドニング", desc: "足元ロードノイズ根本対策", price: "39,000円〜" },
      { menu: "天井ルーフ 遮熱断熱防音", desc: "雨音低減・車中泊の快適化", price: "55,000円〜" }
    ]} />
    <Comparison />
    <ServicePlan prefName={data.prefName} />
    <FAQ prefName={data.prefName} faqItems={faqItems} initiallyOpen={3} />
    <Related relatedRegions={data.relatedRegions} currentRegion={entry.id} />
    <Area prefName={data.prefName} areaBlocks={data.areaBlocks} />
    <Closing prefName={data.prefName} />
  </main>
  <Footer relatedRegions={data.relatedRegions} />
</Layout>
