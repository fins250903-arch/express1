---
import Layout from '../../layouts/Layout.astro';
import { TRUST } from '../../data/trustSignals';

const title = '送信しました｜出張デッドニング 特急便';
const description = 'デッドニングのお問い合わせを受け付けました。担当者から折り返します。';
const canonical = 'https://abura.site/deadning/thanks/';
---

<Layout title={title} description={description} canonical={canonical} noindex={true}>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'deadning_inquiry_submit',
      form_name: 'デッドニングお問い合わせ',
      form_provider: 'formsubmit',
    });
  </script>

  <main class="thanks">
    <div class="container">
      <p class="thanks-brand">{TRUST.brand}</p>
      <h1>送信しました</h1>
      <p class="thanks-lead">
        お問い合わせを受け付けました。内容を確認し、担当者からお電話またはメッセージでご連絡します。
      </p>
      <p class="thanks-lead">お急ぎの場合は、LINEかお電話でもご相談いただけます。</p>
      <div class="thanks-actions">
        <a href={TRUST.lineUrl} target="_blank" rel="noopener noreferrer" class="btn-cta-primary">
          <i class="fab fa-line"></i> LINEで無料見積もり
        </a>
        <a href={`tel:${TRUST.phone}`} class="thanks-tel">
          <i class="fas fa-phone-alt"></i> {TRUST.phone}
        </a>
        <a href="/deadning/" class="thanks-back">デッドニングのページへ戻る</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  :global(body) {
    background: #1a1a2e;
  }
  .thanks {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 55%, #2a1f3d 100%);
    color: #fff;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 64px 0 96px;
  }
  .thanks-brand {
    font-size: 12px;
    font-weight: 800;
    color: var(--color-gold);
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .thanks h1 {
    font-size: clamp(28px, 6vw, 36px);
    font-weight: 900;
    line-height: 1.35;
    margin-bottom: 16px;
  }
  .thanks-lead {
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 12px;
  }
  .thanks-actions {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .thanks-tel,
  .thanks-back {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 12px 16px;
    border-radius: 9999px;
    font-weight: 800;
    text-align: center;
  }
  .thanks-tel {
    border: 2px solid var(--color-gold);
    color: var(--color-gold);
  }
  .thanks-back {
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
  }
</style>
